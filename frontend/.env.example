# Copy to .env.local. Everything here is inlined at build time by Next.js.
# Leave ESCROW_ID unset to browse the four screens against bundled fixture data (demo mode).

# Deployed Patron escrow contract account
NEXT_PUBLIC_ESCROW_ID=patron.your-account.testnet

# NEP-141 stable unit the escrow holds
NEXT_PUBLIC_TOKEN_ID=pusd.your-account.testnet
NEXT_PUBLIC_TOKEN_DECIMALS=6

NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org

# Force fixtures even when an escrow is configured
# NEXT_PUBLIC_DEMO_MODE=true
